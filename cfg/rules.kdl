// General Window Rules
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Fix transparency borders for terminals and specific apps
window-rule {
    match app-id=r#"^org\.gnome\."#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background true
}
// Force VSCode and Helium to 50% width
window-rule {
    match app-id=r#"helium"#
	match app-id=r#"^code$"#
    default-column-width { proportion 0.5; }
}
// Application Specific Rules
// Telegram Media Viewer
window-rule {
    match app-id="^org.telegram.desktop$" title="^Media viewer$"
    open-fullscreen false
}

// Steam Floating Windows & Popups
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// Layer Rules
layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}
